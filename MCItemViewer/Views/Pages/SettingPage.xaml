<Page x:Class="MCItemViewer.Views.Pages.SettingPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="clr-namespace:MCItemViewer.Views.Pages"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:helpers="clr-namespace:MCItemViewer.Helpers"
    xmlns:materialIcons="clr-namespace:Material.Icons.WPF;assembly=Material.Icons.WPF"
    mc:Ignorable="d"
    Title="SettingPage"
    d:DataContext="{d:DesignInstance local:SettingPage, IsDesignTimeCreatable=False}"
    d:DesignHeight="530"
    d:DesignWidth="950"
    ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
    ui:Design.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    Foreground="{DynamicResource TextFillColorPrimaryBrush}">

    <StackPanel Margin="10,0,10,10">
        <TextBlock Text="{Binding Source={x:Static helpers:LocalizationManager.Instance}, Path=[Settings_DisplaySectionLabel]}" Margin="0,10,0,5" FontWeight="Bold"/>
        <Border
            Background="{DynamicResource FlyoutBackground}"
            BorderBrush="{DynamicResource FlyoutBorderBrush}"
            BorderThickness="1"
            CornerRadius="5">
            <StackPanel>
                <!-- テーマ -->
                <Grid VerticalAlignment="Center" Margin="10,10,10,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="32"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="200"/>
                    </Grid.ColumnDefinitions>

                    <materialIcons:MaterialIcon Kind="ThemeLightDark" Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center" Grid.Column="0"/>
                    <TextBlock Text="{Binding Source={x:Static helpers:LocalizationManager.Instance}, Path=[Settings_ThemeLabel]}" HorizontalAlignment="Left" VerticalAlignment="Center" Grid.Column="1"/>
                    <ComboBox
                        x:Name="ThemeList"
                        Grid.Column="2"
                        FontSize="12"
                        ItemsSource="{Binding ViewModel.ThemeList}"
                        DisplayMemberPath="Label"
                        SelectedValuePath="Key"
                        SelectedValue="{Binding ViewModel.SelectedTheme, Mode=TwoWay}"/>
                </Grid>

                <!-- 言語 -->
                <Grid VerticalAlignment="Center" Margin="10,10,10,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="32"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="200"/>
                    </Grid.ColumnDefinitions>

                    <materialIcons:MaterialIcon Kind="Translate" Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center" Grid.Column="0"/>
                    <TextBlock Text="{Binding Source={x:Static helpers:LocalizationManager.Instance}, Path=[Settings_LanguageLabel]}" HorizontalAlignment="Left" VerticalAlignment="Center" Grid.Column="1"/>
                    <ComboBox
                        x:Name="LanguageList"
                        Grid.Column="2"
                        FontSize="12"
                        ItemsSource="{Binding ViewModel.LanguageList}"
                        DisplayMemberPath="Label"
                        SelectedValuePath="Key"
                        SelectedValue="{Binding ViewModel.SelectedLanguage, Mode=TwoWay}"/>
                </Grid>
            </StackPanel>
        </Border>
    </StackPanel>
</Page>
